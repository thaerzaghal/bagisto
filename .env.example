APP_NAME=Bagisto
APP_ENV=local
APP_KEY=
# TASK-MVP-004A: fine for local development. PRODUCTION MUST SET THIS TO
# false - true leaks stack traces (including config/secret values) on
# error pages. See docs/architecture/production-deployment.md and
# `php artisan platform:production:check`.
APP_DEBUG=true
APP_DEBUG_ALLOWED_IPS=
APP_URL=http://localhost
APP_ADMIN_URL=admin
APP_TIMEZONE=Asia/Kolkata

# TASK-MVP-004A. Comma-separated IP addresses/CIDR ranges of your reverse
# proxy/load balancer (whitespace around each entry is trimmed, empty
# entries are dropped) - e.g. TRUSTED_PROXIES=10.0.0.5,10.0.0.6 or a CIDR
# range like 10.0.0.0/8. Leave BLANK for local development (falls back to
# trusting all proxies, today's exact previous behavior - zero setup
# required). PRODUCTION MUST SET THIS to the real proxy's address(es), or
# X-Forwarded-* headers (host/proto/port) from ANY client would be
# trusted, which could spoof HTTPS detection or the resolved Host. See
# docs/architecture/production-deployment.md (RISK_REGISTER.md R20).
TRUSTED_PROXIES=

# TASK-MVP-004A. The parent hostname tenant subdomains attach to
# ({slug}.{PLATFORM_BASE_DOMAIN}) - see config/platform.php. Local/dev
# default only; production must set this to the real chosen domain.
PLATFORM_BASE_DOMAIN=platform.test

# TASK-MVP-004A. Comma-separated hostname(s) serving the CENTRAL app only
# (Platform Admin, signup) - see config/tenancy.php. Deliberately NOT
# derived from PLATFORM_BASE_DOMAIN above (the two may legitimately
# differ - see that config file's own comment). 127.0.0.1/localhost are
# always included as local-dev defaults regardless of this value.
# PRODUCTION MUST SET THIS to the real central-app hostname(s).
PLATFORM_CENTRAL_DOMAINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_CURRENCY=USD

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

# Tenant database provisioning credentials (config/database.php "tenant_provisioning"
# connection). Distinct from DB_USERNAME/DB_PASSWORD above - see
# docs/architecture/provisioning.md "Database provisioning credentials". Required
# grants: CREATE, DROP, CREATE USER, GRANT OPTION on *.*. Leave unset to fall back
# to DB_USERNAME/DB_PASSWORD (fine for local dev, NOT for production).
# TASK-MVP-004A: PRODUCTION MUST use a dedicated, non-root user here - never
# MySQL root (`php artisan platform:production:check` flags a literal
# "root" username). See docs/architecture/production-deployment.md.
DB_PROVISION_USERNAME=
DB_PROVISION_PASSWORD=

# TASK-MVP-003A: platform:backup:run's destination - MUST be a path OUTSIDE
# storage_path() (INCIDENT-001's own lesson: a backup nested inside the same
# mutable tree it protects is not a real backup). Production sets this to
# /backups (docker-compose.production.yml mounts ../backups:/backups, a
# sibling of the app/mysql-data volumes, never nested inside either). Local
# dev's default (storage_path('backups')) is a convenience only - never
# relied on for anything real. See docs/implementation/backup-and-recovery.md.
BACKUP_ROOT=
BACKUP_RETENTION_DAYS=7

# TASK-MVP-004A: this is the proven, already-tested architecture (tenant
# sessions in each tenant's own DB, Platform Admin sessions in the central
# DB - both real, isolated `sessions` tables). Keep as `database` for
# production too; no concrete reason to move to Redis has been found.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# TASK-MVP-004A: `sync` is the recommended posture for the initial pilot -
# queued jobs (including order-confirmation mail) run inline, no separate
# queue worker process is required. See docs/architecture/
# production-deployment.md before switching to an async connection.
QUEUE_CONNECTION=sync

# TASK-ARCH-006 (R6/R7): explicitly pin the 'database' queue driver's own
# connection to the central connection name, rather than leaving it unset
# (which falls back to config('database.default') at whatever moment the
# 'database' queue connection object first gets resolved - under tenancy,
# that value swaps between 'mysql' and 'tenant' depending on context, per
# Stancl\Tenancy\Database\DatabaseManager::setDefaultConnection()). Queue
# infrastructure (the 'jobs' table) must always be central, never a
# tenant's own database - see docs/architecture/queues.md. Has no effect
# while QUEUE_CONNECTION=sync/redis (this app's actual choice - see the
# same doc for why); set defensively so switching to the 'database' driver
# later doesn't silently reopen this ambiguity.
DB_QUEUE_CONNECTION=mysql

# TASK-ARCH-004 (RISK_REGISTER.md R15): Stancl\Tenancy\Bootstrappers\CacheTenancyBootstrapper
# is enabled (config/tenancy.php) and tags EVERY cache call for isolation - this requires a
# store that supports Laravel cache tagging. `file` and `database` do NOT support tagging and
# will throw immediately. `redis` (default here, already provisioned in docker-compose.yml) is
# the production recommendation; `array` is a valid alternative for local dev/automated tests
# (in-process, no external service, resets every run) - see tests/Feature/Platform/*CacheTest.php.
CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# TASK-ARCH-015B (DECISION_LOG.md C15, RISK_REGISTER.md R1): kept OFF by default for the
# SaaS build until tenant-safe full-page response-cache keys are explicitly implemented and
# proven - the shipped Bagisto default of `true` would otherwise reintroduce R1's cross-tenant
# leak risk (packages/Webkul/FPC's cache-key hasher does not scope by tenant). Do not flip this
# to `true` without first closing R1 for real (a dedicated tenant-scoped-key task), not just
# because CacheTenancyBootstrapper/Redis (see CACHE_STORE above) are already in place - those
# address ordinary Cache::-facade isolation, not this separate full-page-cache mechanism.
RESPONSE_CACHE_ENABLED=false

MAIL_MAILER=bagisto-dynamic-smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

MAIL_FROM_ADDRESS=shop@example.com
MAIL_FROM_NAME=Shop
ADMIN_MAIL_ADDRESS=admin@example.com
ADMIN_MAIL_NAME=Admin
CONTACT_MAIL_ADDRESS=contact@example.com
CONTACT_MAIL_NAME=Contact

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_HOST=localhost
VITE_PORT=

# TASK-ARCH-018. Stripe is this platform's first REFERENCE billing adapter
# only (sandbox/test mode) - not a production commitment. See
# docs/architecture/billing.md. Use TEST keys only; never commit real ones.
# TASK-MVP-004A: for the pilot, RECOMMENDED to leave STRIPE_KEY/STRIPE_SECRET/
# STRIPE_WEBHOOK_SECRET blank (today's default) - a merchant clicking
# "Upgrade Plan" then sees a clean "billing not available yet" message
# (bootstrap/app.php), never a real (or fake-looking) payment facility.
# Plan changes during the pilot are handled via Platform Admin's own manual
# "change plan" action instead. See docs/architecture/production-deployment.md.
BILLING_PROVIDER=stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
